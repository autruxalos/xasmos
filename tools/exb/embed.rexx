/* embed.rexx -- turns a .exb image into a C header with a byte array.
 * Output format matches the committed prog_exb.h exactly: 16 bytes per line,
 * "0xHH" separated by ", ", a trailing comma on every line, and the length
 * as a separate constant. Usage:
 *   rexx tools/exb/embed.rexx IN.exb OUT.h NAME
 * NOTE: use PARSE ARG, never ARG (ARG uppercases its input in REXX). */
numeric digits 20

parse arg inp out name
if inp = '' | out = '' | name = '' then do
  say 'usage: rexx tools/exb/embed.rexx IN.exb OUT.h NAME'
  exit 2
end

data = read_bin(inp)
n = length(data)
if n = 0 then do
  say 'embed: cannot read' inp
  exit 1
end

call stream out, 'c', 'close'
call stream out, 'c', 'open write replace'
call lineout out, '/* generated by tools/exb/embed.rexx from' inp '-- do not edit */'
call lineout out, 'static const unsigned char' name'[] = {'

do i = 1 to n by 16
  line = '   '
  do j = i to min(i + 15, n)
    line = line || ' 0x' || c2x(substr(data, j, 1)) || ','
  end
  call lineout out, line
end

call lineout out, '};'
call lineout out, 'static const unsigned long' name'_len =' n';'
rc = stream(out, 'c', 'close')
say 'embed:' n 'bytes ->' out

exit 0

min: procedure
  parse arg a, b
  if a < b then return a
  return b

read_bin: procedure
  parse arg name
  call stream name, 'c', 'open read'
  size = stream(name, 'c', 'query size')
  if size = '' | size = 0 then do
    call stream name, 'c', 'close'
    return ''
  end
  data = charin(name, 1, size)
  call stream name, 'c', 'close'
  return data
